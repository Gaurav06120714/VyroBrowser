# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/
*.tsbuildinfo

# Environment files (NEVER commit — contain secrets)
.env
.env.local
.env.*.local
apps/**/.env
apps/**/.env.local
apps/**/.env.production.local
