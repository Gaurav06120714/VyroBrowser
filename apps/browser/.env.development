# ─────────────────────────────────────────────────────────────────────────────
# .env.development — local developer overrides.
# Loaded automatically by Vite when NODE_ENV=development.
# NEVER commit secrets here; keep this file in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Electron dev flag — tells main/index.ts to use the Vite dev server URL
ELECTRON_IS_DEV=1

# Renderer dev server (Vite default)
VITE_DEV_SERVER_URL=http://localhost:5173

# Ollama — local instance (default port)
VITE_OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# API server (apps/api — optional)
API_PORT=3001
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# SQLite path (relative to userData, resolved at runtime in db.ts)
DATABASE_PATH=vyro-dev.db

# Logging
LOG_LEVEL=debug
NODE_ENV=development
