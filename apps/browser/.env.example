# Vyro Browser — Environment Variables
# Copy this file to .env.development or .env.production and fill in values.
# Never commit files containing real secrets.

# ── Electron ──────────────────────────────────────────────────────────────────
# Set to '1' to run in development mode (loads Vite dev server, opens DevTools)
ELECTRON_IS_DEV=1
NODE_ENV=development

# ── Ollama ───────────────────────────────────────────────────────────────────
# Base URL for the local Ollama API server
OLLAMA_BASE_URL=http://localhost:11434

# ── Database ─────────────────────────────────────────────────────────────────
# Optional: override the default userData path for the SQLite database.
# Leave empty to use the OS default (~/.config/Vyro/ on Linux, etc.)
# DATABASE_PATH=

# ── Logging ──────────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | silent
LOG_LEVEL=debug

# ── Renderer (Vite) ──────────────────────────────────────────────────────────
# These are injected into the renderer via Vite's import.meta.env.*
VITE_APP_VERSION=0.1.0
VITE_OLLAMA_BASE_URL=http://localhost:11434
