# ─────────────────────────────────────────────────────────────────────────────
# .env.production — values baked into production builds.
# Vite inlines VITE_* vars at build time; non-VITE_* vars are runtime only.
# Override with a local .env file that is NOT committed to git.
# ─────────────────────────────────────────────────────────────────────────────

ELECTRON_IS_DEV=0

# Ollama — production apps still talk to the user's local Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# No remote API in the default production build (fully local)
API_PORT=3001

# SQLite path
DATABASE_PATH=vyro.db

# Logging
LOG_LEVEL=warn
NODE_ENV=production
