{
  "name": "vyro-browser",
  "version": "2.0.0",
  "description": "Vyro — AI-powered desktop browser",
  "main": "dist-main/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "package:dir": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir",
    "install-app": "npm run package:dir && cp -r dist/mac-arm64/Vyro.app /Applications/Vyro.app && echo 'Installed'"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.31.0",
    "better-sqlite3": "^12.10.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uuid": "^9.0.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "build": {
    "appId": "com.vyro.browser",
    "productName": "Vyro",
    "copyright": "Copyright © 2025 Vyro Browser",
    "asar": true,
    "asarUnpack": [
      "assets/**"
    ],
    "files": [
      "dist-main/**",
      "dist-renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Vyro Browser",
      "icon": "assets/icon.icns",
      "iconSize": 128,
      "window": {
        "width": 720,
        "height": 400
      }
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  }
}
